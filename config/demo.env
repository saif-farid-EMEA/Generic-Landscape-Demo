# =============================================================================
# demo.env: every setting for the Landscape demo lab lives here.
# All scripts in scripts/ load this file, so change values here only.
# =============================================================================

# --- Landscape Server -------------------------------------------------------
# PPA to install Landscape Server from (24.04 LTS = simplest quickstart path)
LANDSCAPE_PPA="ppa:landscape/self-hosted-24.04"
# Short hostname and full domain name the server will answer on
SERVER_HOSTNAME="landscape"
FQDN="landscape.demo.internal"
# Multipass VM name and size for the server
SERVER_VM="landscape-server"
SERVER_RELEASE="24.04"
SERVER_CPUS=4
SERVER_MEM="8G"
SERVER_DISK="50G"

# --- Landscape clients ------------------------------------------------------
# One entry per client, formatted as  "vm-name:ubuntu-release:comma,separated,tags"
CLIENTS=(
  "web-01:24.04:demo,web"
  "db-01:24.04:demo,db"
  "legacy-01:22.04:demo,legacy"
)
# Size of every client VM
CLIENT_CPUS=1
CLIENT_MEM="2G"
CLIENT_DISK="10G"
# Fast check-in intervals (seconds) so the demo updates in seconds, not minutes
EXCHANGE_INTERVAL=60
URGENT_EXCHANGE_INTERVAL=10
PING_INTERVAL=10

# --- Repository management demo ---------------------------------------------
# Small upstream apt repo to mirror (Google Chrome: ~3 packages)
MIRROR_URI="https://dl.google.com/linux/chrome/deb/"
MIRROR_SUITE="stable"
MIRROR_COMPONENT="main"
MIRROR_ARCH="amd64"
# Names used inside Landscape for the mirror
REPO_DISTRIBUTION="internal"
REPO_SERIES="chrome"
REPO_POCKET="release"
REPO_GPG_KEY_NAME="mirror-key"
REPO_PROFILE="internal-apps"

# --- Snapshots ---------------------------------------------------------------
# Name of the snapshot used to reset the lab between rehearsals
SNAPSHOT_NAME="demo-ready"
