# =============================================================================
# demo.env: every setting for the Landscape demo lab lives here.
# All scripts in scripts/ load this file, so change values here only.
#
# How to read this file:
#   - Lines starting with "#" are comments (notes for humans); they are ignored.
#   - Every other line sets a variable: NAME="value". Keep it exactly in that
#     shape: no spaces around the "=", and keep the quotes where they are.
#   - Edit it with any text editor, e.g.  nano config/demo.env
#     (in nano: save with Ctrl+O then Enter, exit with Ctrl+X).
#   - Changes only affect VMs created afterwards. To apply new sizes or names
#     to an existing lab, run scripts/99-cleanup.sh and set up again.
# =============================================================================

# --- Landscape Server -------------------------------------------------------
# PPA ("Personal Package Archive", an extra software source) to install
# Landscape Server from. 24.04 LTS is the simplest quickstart path.
LANDSCAPE_PPA="ppa:landscape/self-hosted-24.04"
# The server's short name, and its full name (FQDN = "fully qualified domain
# name"). The full name is what you type in your browser: https://<FQDN>
SERVER_HOSTNAME="landscape"
FQDN="landscape.demo.internal"
# The server VM's name in Multipass, which Ubuntu version it runs, and its size:
# number of CPU cores, memory (RAM) and disk space. "G" means gigabytes.
SERVER_VM="landscape-server"
SERVER_RELEASE="24.04"
SERVER_CPUS=4
SERVER_MEM="8G"
SERVER_DISK="50G"

# --- Landscape clients ------------------------------------------------------
# One entry per client, formatted as  "vm-name:ubuntu-release:comma,separated,tags"
# The round brackets make CLIENTS a list. To add a client, copy a line inside the
# brackets and change it; to remove one, delete its line. Tags are labels used
# to group machines in the portal; keep "demo" on every client, because the
# demo scripts target "tag:demo".
CLIENTS=(
  "web-01:24.04:demo,web"
  "db-01:24.04:demo,db"
  "legacy-01:22.04:demo,legacy"
)
# Size of every client VM
CLIENT_CPUS=1
CLIENT_MEM="2G"
CLIENT_DISK="10G"
# Fast check-in intervals (seconds) so the demo updates in seconds, not minutes
EXCHANGE_INTERVAL=60
URGENT_EXCHANGE_INTERVAL=10
PING_INTERVAL=10

# --- Repository management demo ---------------------------------------------
# The outside software repository to copy ("mirror") into Landscape. We use
# Google Chrome's because it is tiny (~3 packages), so it downloads quickly.
#   MIRROR_URI        the repository's web address
#   MIRROR_SUITE      which release channel inside it to copy
#   MIRROR_COMPONENT  which section of that channel
#   MIRROR_ARCH       which processor type (amd64 = normal Intel/AMD PCs)
MIRROR_URI="https://dl.google.com/linux/chrome/deb/"
MIRROR_SUITE="stable"
MIRROR_COMPONENT="main"
MIRROR_ARCH="amd64"
# Names used inside Landscape for the mirror (you will see these in the portal).
# See scripts/remote/setup-repo-mirror.sh for what each layer means.
REPO_DISTRIBUTION="internal"
REPO_SERIES="chrome"
REPO_POCKET="release"
REPO_GPG_KEY_NAME="mirror-key"
REPO_PROFILE="internal-apps"

# --- Snapshots ---------------------------------------------------------------
# Name of the snapshot used to reset the lab between rehearsals
SNAPSHOT_NAME="demo-ready"
