# Copy this file to config/api.env and paste your Landscape API credentials.
# From the repo folder in a terminal, that's:
#   cp config/api.env.example config/api.env
# Then open config/api.env in any text editor (e.g. "nano config/api.env";
# in nano, save with Ctrl+O then Enter, and exit with Ctrl+X).
# Get the keys in the web portal: your account settings -> API credentials -> Generate.
# Replace only the text between the quotes, and keep the quotes.
# config/api.env is git-ignored, so your keys never get committed (uploaded).
LANDSCAPE_API_KEY="PASTE_ACCESS_KEY_HERE"
LANDSCAPE_API_SECRET="PASTE_SECRET_KEY_HERE"
